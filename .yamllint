---
extends: default

rules:
  line-length:
    max: 200
    level: warning
  truthy:
    check-keys: false
    allowed-values: ["true", "false", "yes", "no"]
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  indentation:
    spaces: 2
    indent-sequences: true
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true

ignore:
  - .git/
  - demo/target/
  - demo/.mvn/
  - helm/*/templates/
